<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uitk="UitkForKsp2.Controls" editor-extension-mode="False">
    <!-- MunShot's photo mode: a full-screen overlay. The scene fills the screen; a flight panel on the left edge (opened
         and closed by its bar toggle, as Redux's orbital info panel is), a shutter and a hint bar sit on its edges, and
         the Hide UI key hides them all. Inside the panel, a strip of icon tabs runs down the left side, as the VAB's
         part picker's categories do, each named by a tooltip, and the open page is named at its top. Built from the
         KerbalUI theme's own pieces, as Redux's panels are: flight-panel, bar-toggle, InvertedCornerBox, OabButton,
         switch toggles, Tooltip, the SDK's ColorPicker; PhotoModeWindow.uss places them, colours the tab strip as the
         part picker's, and fits the colour picker to the panel. Only the
         panels take clicks: the rest of the screen is the scene. Its data source is a PhotoModeViewModel, whose
         commands the buttons run (CommandBinding); PhotoModeWindow fills the lists and wires the other controls. Texts
         starting with # are localization keys (Copied/localizations/munshot_localization.csv); "uppercase" elements are
         shown in capitals (bound text through the UppercaseLocalization converter). -->
    <Style src="PhotoModeWindow.uss" />
    <ui:VisualElement name="photo-mode" class="pm-root" picking-mode="Ignore">
        <ui:VisualElement name="chrome" class="pm-chrome" picking-mode="Ignore">

            <ui:VisualElement name="sidebar" class="pm-sidebar">
                <!-- Opens and closes the panel -->
                <ui:Toggle name="panel-toggle" value="true" class="dark bar-toggle bar-toggle-vertical">
                    <ui:VisualElement class="bar-toggle-arrow" />
                    <ui:VisualElement class="bar-toggle-dot" />
                    <ui:VisualElement class="bar-toggle-dot bar-toggle-dot-open" />
                    <ui:VisualElement class="bar-toggle-arrow" />
                </ui:Toggle>

                <ui:VisualElement name="side-panel" class="root flight-panel pm-panel">
                    <ui:VisualElement class="flight-panel-outer-container">
                        <ui:VisualElement class="flight-panel-inner-container pm-panel-inner">
                            <ui:VisualElement class="pm-title-row">
                                <ui:Label text="// " class="pm-title pm-dim" />
                                <ui:Label text="#MunShot/UI/Title" class="pm-title uppercase" />
                            </ui:VisualElement>

                            <ui:Label text="................................................" class="pm-divider" />

                            <ui:VisualElement class="pm-body">
                                <!-- The tabs: icon keys down the left side, as the VAB's part categories; each one's name is
                                     its tooltip ("R:" shows it to the right; the "#key" is translated as it's shown) -->
                                <ui:VisualElement class="pm-strip">
                                    <uitk:OabButton name="tab-kerbals" tooltip="R:#MunShot/UI/Kerbals" class="pm-strip-tab">
                                        <Bindings>
                                            <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="ShowKerbalsCommand" />
                                        </Bindings>
                                        <ui:VisualElement class="pm-strip-icon pm-icon-kerbals" picking-mode="Ignore" />
                                    </uitk:OabButton>
                                    <uitk:OabButton name="tab-pose" tooltip="R:#MunShot/UI/Pose" class="pm-strip-tab">
                                        <Bindings>
                                            <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="ShowPoseCommand" />
                                        </Bindings>
                                        <ui:VisualElement class="pm-strip-icon pm-icon-pose" picking-mode="Ignore" />
                                    </uitk:OabButton>
                                    <uitk:OabButton name="tab-camera" tooltip="R:#MunShot/UI/Camera" class="pm-strip-tab">
                                        <Bindings>
                                            <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="ShowCameraCommand" />
                                        </Bindings>
                                        <ui:VisualElement class="pm-strip-icon pm-icon-camera" picking-mode="Ignore" />
                                    </uitk:OabButton>
                                    <uitk:OabButton name="tab-color" tooltip="R:#MunShot/UI/Color" class="pm-strip-tab">
                                        <Bindings>
                                            <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="ShowColorCommand" />
                                        </Bindings>
                                        <ui:VisualElement class="pm-strip-icon pm-icon-color" picking-mode="Ignore" />
                                    </uitk:OabButton>
                                    <uitk:OabButton name="tab-light" tooltip="R:#MunShot/UI/Light" class="pm-strip-tab">
                                        <Bindings>
                                            <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="ShowLightCommand" />
                                        </Bindings>
                                        <ui:VisualElement class="pm-strip-icon pm-icon-light" picking-mode="Ignore" />
                                    </uitk:OabButton>
                                </ui:VisualElement>

                                <ui:VisualElement class="pm-pages">
                                    <!-- The open page's name, as the VAB names the category it shows -->
                                    <ui:VisualElement class="pm-heading-row pm-page-title-row">
                                        <ui:Label text="> " class="pm-page-title pm-dim" />
                                        <ui:Label class="pm-page-title">
                                            <Bindings>
                                                <ui:DataBinding property="text" data-source-path="PageTitle" binding-mode="ToTarget" source-to-ui-converters="UppercaseLocalization" />
                                            </Bindings>
                                        </ui:Label>
                                    </ui:VisualElement>

                                    <!-- Kerbals: who's in the shot (click to select, x to take out), bring someone in, helmet and visor -->
                                    <ui:VisualElement name="page-kerbals" class="pm-page">
                                        <uitk:InvertedCornerBox background-color="#161B21FF" class="pm-box">
                                            <ui:ScrollView name="kerbal-list" class="pm-list" />
                                            <ui:Label text="#MunShot/UI/NobodyIn" class="pm-empty">
                                                <Bindings>
                                                    <ui:DataBinding property="style.display" data-source-path="HasKerbals" binding-mode="ToTarget" source-to-ui-converters="MunShotInvertedBoolToDisplay" />
                                                </Bindings>
                                            </ui:Label>
                                        </uitk:InvertedCornerBox>
                                        <uitk:OabButton name="bring-in" text="#MunShot/UI/BringInKerbal" class="pm-wide">
                                            <Bindings>
                                                <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="BringInCommand" />
                                            </Bindings>
                                        </uitk:OabButton>

                                        <ui:VisualElement name="kerbal-gear">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="HasKerbals" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
                                            </Bindings>
                                            <ui:VisualElement class="pm-heading-row">
                                                <ui:Label text="## " class="pm-heading pm-dim" />
                                                <ui:Label class="pm-heading">
                                                    <Bindings>
                                                        <ui:DataBinding property="text" data-source-path="SelectedName" binding-mode="ToTarget" source-to-ui-converters="UppercaseLocalization" />
                                                    </Bindings>
                                                </ui:Label>
                                            </ui:VisualElement>
                                            <uitk:InvertedCornerBox background-color="#161B21FF" class="pm-box">
                                                <ui:Toggle name="helmet" label="#MunShot/UI/Helmet" class="switch" />
                                                <ui:Toggle name="visor" label="#MunShot/UI/Visor" class="switch" />
                                            </uitk:InvertedCornerBox>
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <!-- Pose: the selected kerbal's pose, and moving them -->
                                    <ui:VisualElement name="page-pose" class="pm-page">
                                        <!-- Until someone's brought in there's nobody to pose -->
                                        <uitk:InvertedCornerBox background-color="#161B21FF" class="pm-box">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="HasKerbals" binding-mode="ToTarget" source-to-ui-converters="MunShotInvertedBoolToDisplay" />
                                            </Bindings>
                                            <ui:Label text="#MunShot/UI/AddKerbalFirst" class="pm-empty" />
                                        </uitk:InvertedCornerBox>
                                        <ui:VisualElement name="pose-tools">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="HasKerbals" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
                                            </Bindings>
                                            <ui:VisualElement class="pm-heading-row">
                                                <ui:Label text="## " class="pm-heading pm-dim" />
                                                <ui:Label class="pm-heading">
                                                    <Bindings>
                                                        <ui:DataBinding property="text" data-source-path="SelectedName" binding-mode="ToTarget" source-to-ui-converters="UppercaseLocalization" />
                                                    </Bindings>
                                                </ui:Label>
                                            </ui:VisualElement>
                                            <uitk:InvertedCornerBox background-color="#161B21FF" class="pm-box">
                                                <ui:ScrollView name="pose-list" class="pm-list pm-list--tall" />
                                            </uitk:InvertedCornerBox>
                                            <ui:Toggle name="jetpack" label="#MunShot/UI/Jetpack" class="switch" />
                                            <ui:VisualElement class="pm-row">
                                                <uitk:OabButton name="tool-move" text="#MunShot/UI/Move" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="MoveToolCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                                <uitk:OabButton name="tool-rotate" text="#MunShot/UI/Rotate" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="RotateToolCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                            </ui:VisualElement>
                                            <ui:Toggle name="angle-snap" label="#MunShot/UI/AngleSnap" class="switch" />
                                            <ui:VisualElement class="pm-row">
                                                <uitk:OabButton name="snap-to-surface" text="#MunShot/UI/SnapToSurface" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="SnapToSurfaceCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                                <uitk:OabButton name="stand-upright" text="#MunShot/UI/StandUpright" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="StandUprightCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>

                                    <!-- Camera: fly free or circle something, how wide it sees, fisheye, and what's in focus -->
                                    <ui:VisualElement name="page-camera" class="pm-page">
                                        <ui:VisualElement class="pm-row">
                                            <uitk:OabButton name="camera-free" text="#MunShot/UI/Free" class="pm-grow">
                                                <Bindings>
                                                    <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="FreeCameraCommand" />
                                                </Bindings>
                                            </uitk:OabButton>
                                            <uitk:OabButton name="camera-orbit" text="#MunShot/UI/Orbit" class="pm-grow">
                                                <Bindings>
                                                    <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="OrbitCameraCommand" />
                                                </Bindings>
                                            </uitk:OabButton>
                                        </ui:VisualElement>
                                        <!-- What Orbit circles: only while orbiting -->
                                        <ui:VisualElement name="orbit-section">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="IsOrbiting" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
                                            </Bindings>
                                            <ui:VisualElement class="pm-heading-row">
                                                <ui:Label text="## " class="pm-heading pm-dim" />
                                                <ui:Label text="#MunShot/UI/OrbitAround" class="pm-heading uppercase" />
                                            </ui:VisualElement>
                                            <uitk:InvertedCornerBox background-color="#161B21FF" class="pm-box">
                                                <ui:ScrollView name="orbit-list" class="pm-list" />
                                            </uitk:InvertedCornerBox>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/FieldOfView" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="field-of-view" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="FieldOfViewText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <!-- Fisheye: the picture bulges out from its middle, as through a fisheye lens -->
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/Fisheye" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="fisheye" low-value="0" high-value="1" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="FisheyeText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>

                                        <!-- Depth of field: what's sharp, and how much the rest blurs (a lower f-number blurs more); moving either
                                             slider, or focusing on the selected kerbal, turns it on -->
                                        <ui:Toggle name="depth-of-field" label="#MunShot/UI/DepthOfField" class="switch" />
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/FocusDistance" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="focus-distance" low-value="0" high-value="1" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="FocusDistanceText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/Blur" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="blur" low-value="0" high-value="1" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="ApertureText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <uitk:OabButton name="focus-on-selected" text="#MunShot/UI/FocusOnSelected" class="pm-wide">
                                            <Bindings>
                                                <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="FocusOnSelectedCommand" />
                                            </Bindings>
                                        </uitk:OabButton>
                                    </ui:VisualElement>

                                    <!-- Color: the picture's exposure, contrast, saturation and warmth; 0 is the game's own -->
                                    <ui:VisualElement name="page-color" class="pm-page">
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/Exposure" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="exposure" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="ExposureText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/Contrast" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="contrast" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="ContrastText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/Saturation" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="saturation" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="SaturationText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-heading-row">
                                            <ui:Label text="## " class="pm-heading pm-dim" />
                                            <ui:Label text="#MunShot/UI/Warmth" class="pm-heading uppercase" />
                                        </ui:VisualElement>
                                        <ui:VisualElement class="pm-row">
                                            <ui:Slider name="warmth" class="pm-grow" />
                                            <ui:Label class="pm-value">
                                                <Bindings>
                                                    <ui:DataBinding property="text" data-source-path="WarmthText" binding-mode="ToTarget" />
                                                </Bindings>
                                            </ui:Label>
                                        </ui:VisualElement>
                                        <uitk:OabButton name="reset-color" text="#MunShot/UI/ResetColor" class="pm-wide">
                                            <Bindings>
                                                <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="ResetColorCommand" />
                                            </Bindings>
                                        </uitk:OabButton>
                                    </ui:VisualElement>

                                    <!-- Light: photo mode's own lights (click to select, x to take away), added in front of the
                                         camera and moved with the handles; the selected one's shape, colour, brightness and reach -->
                                    <ui:VisualElement name="page-light" class="pm-page">
                                        <uitk:InvertedCornerBox background-color="#161B21FF" class="pm-box">
                                            <ui:ScrollView name="light-list" class="pm-list" />
                                            <ui:Label text="#MunShot/UI/NoLights" class="pm-empty">
                                                <Bindings>
                                                    <ui:DataBinding property="style.display" data-source-path="HasLights" binding-mode="ToTarget" source-to-ui-converters="MunShotInvertedBoolToDisplay" />
                                                </Bindings>
                                            </ui:Label>
                                        </uitk:InvertedCornerBox>
                                        <uitk:OabButton name="add-light" text="#MunShot/UI/AddLight" class="pm-wide">
                                            <Bindings>
                                                <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="AddLightCommand" />
                                            </Bindings>
                                        </uitk:OabButton>

                                        <ui:VisualElement name="light-settings">
                                            <Bindings>
                                                <ui:DataBinding property="style.display" data-source-path="HasSelectedLight" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
                                            </Bindings>
                                            <ui:VisualElement class="pm-heading-row">
                                                <ui:Label text="## " class="pm-heading pm-dim" />
                                                <ui:Label class="pm-heading">
                                                    <Bindings>
                                                        <ui:DataBinding property="text" data-source-path="SelectedLightName" binding-mode="ToTarget" />
                                                    </Bindings>
                                                </ui:Label>
                                            </ui:VisualElement>
                                            <!-- The same handle tool as the Pose tab's: the light is moved and turned like a kerbal -->
                                            <ui:VisualElement class="pm-row">
                                                <uitk:OabButton name="light-tool-move" text="#MunShot/UI/Move" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="MoveToolCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                                <!-- Only a spot light has a way it faces to turn -->
                                                <uitk:OabButton name="light-tool-rotate" text="#MunShot/UI/Rotate" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="RotateToolCommand" />
                                                        <ui:DataBinding property="style.display" data-source-path="IsSpotLight" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="pm-row">
                                                <uitk:OabButton name="light-point" text="#MunShot/UI/PointLight" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="PointLightCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                                <uitk:OabButton name="light-spot" text="#MunShot/UI/SpotLight" class="pm-grow">
                                                    <Bindings>
                                                        <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="SpotLightCommand" />
                                                    </Bindings>
                                                </uitk:OabButton>
                                            </ui:VisualElement>
                                            <uitk:ColorPicker name="light-color" class="pm-color-picker" />
                                            <ui:VisualElement class="pm-heading-row">
                                                <ui:Label text="## " class="pm-heading pm-dim" />
                                                <ui:Label text="#MunShot/UI/LightBrightness" class="pm-heading uppercase" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="pm-row">
                                                <ui:Slider name="light-brightness" low-value="0" high-value="1" class="pm-grow" />
                                                <ui:Label class="pm-value">
                                                    <Bindings>
                                                        <ui:DataBinding property="text" data-source-path="LightBrightnessText" binding-mode="ToTarget" />
                                                    </Bindings>
                                                </ui:Label>
                                            </ui:VisualElement>
                                            <ui:VisualElement class="pm-heading-row">
                                                <ui:Label text="## " class="pm-heading pm-dim" />
                                                <ui:Label text="#MunShot/UI/LightRange" class="pm-heading uppercase" />
                                            </ui:VisualElement>
                                            <ui:VisualElement class="pm-row">
                                                <ui:Slider name="light-range" low-value="0" high-value="1" class="pm-grow" />
                                                <ui:Label class="pm-value">
                                                    <Bindings>
                                                        <ui:DataBinding property="text" data-source-path="LightRangeText" binding-mode="ToTarget" />
                                                    </Bindings>
                                                </ui:Label>
                                            </ui:VisualElement>
                                            <ui:VisualElement name="spot-angle-section">
                                                <Bindings>
                                                    <ui:DataBinding property="style.display" data-source-path="IsSpotLight" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
                                                </Bindings>
                                                <ui:VisualElement class="pm-heading-row">
                                                    <ui:Label text="## " class="pm-heading pm-dim" />
                                                    <ui:Label text="#MunShot/UI/SpotAngle" class="pm-heading uppercase" />
                                                </ui:VisualElement>
                                                <ui:VisualElement class="pm-row">
                                                    <ui:Slider name="spot-angle" class="pm-grow" />
                                                    <ui:Label class="pm-value">
                                                        <Bindings>
                                                            <ui:DataBinding property="text" data-source-path="SpotAngleText" binding-mode="ToTarget" />
                                                        </Bindings>
                                                    </ui:Label>
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                            <ui:Toggle name="light-kerbals-only" label="#MunShot/UI/KerbalsOnly" class="switch" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Shutter: takes the photo (as the screenshot key does), with all of this hidden -->
            <ui:Button name="shutter" class="pm-shutter">
                <Bindings>
                    <UitkForKsp2.MVVM.Bindings.CommandBinding property="viewDataKey" data-source-path="TakePhotoCommand" />
                </Bindings>
                <ui:VisualElement class="pm-shutter__inner" picking-mode="Ignore" />
            </ui:Button>

            <!-- What the keys do right now: keycaps and what they do, filled by PhotoModeWindow from the bound keys -->
            <ui:VisualElement name="hints" class="pm-hints" />
        </ui:VisualElement>

        <!-- The tabs' names, shown when hovering them (Redux's Tooltip, as on Redux's own windows) -->
        <uitk:Tooltip name="tooltip" />

        <!-- The box being dragged to select several kerbals and lights; placed by PhotoModeWindow while there is one -->
        <ui:VisualElement name="selection-box" class="pm-selection-box" picking-mode="Ignore" />

        <!-- A short note about what just happened; PhotoModeWindow hides it again after a few seconds -->
        <ui:VisualElement name="toast" class="root flight-panel pm-toast" picking-mode="Ignore">
            <Bindings>
                <ui:DataBinding property="style.display" data-source-path="ToastVisible" binding-mode="ToTarget" source-to-ui-converters="MunShotBoolToDisplay" />
            </Bindings>
            <ui:VisualElement class="flight-panel-outer-container" picking-mode="Ignore">
                <ui:VisualElement class="flight-panel-inner-container pm-toast-inner" picking-mode="Ignore">
                    <ui:Label class="pm-toast-text" picking-mode="Ignore">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="Toast" binding-mode="ToTarget" />
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
